# Bu dosyayı key.properties olarak kopyala ve doldur
# key.properties repo'ya commit edilmez (.gitignore'da)
#
# Keystore oluşturmak için:
#   keytool -genkey -v -keystore vitapuls.jks -keyalg RSA -keysize 2048 -validity 10000 -alias vitapuls
# Oluşturulan vitapuls.jks dosyasını güvenli bir yerde sakla (repo dışında)

storePassword=KEYSTORE_PAROLASI
keyPassword=KEY_PAROLASI
keyAlias=vitapuls
storeFile=../vitapuls.jks
