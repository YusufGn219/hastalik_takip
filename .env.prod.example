# Production ortam değişkenleri — bu dosyayı .env.prod olarak kopyala ve doldur
# .env.prod repo'ya commit edilmez (.gitignore'da)

# Django
# Güvenli key üretmek için: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=BURAYA_GUCLU_BIR_SECRET_KEY_YAZIN

# Virgülle ayrılmış host listesi — sunucu IP'si veya domain
ALLOWED_HOSTS=YOUR_SERVER_IP

# Virgülle ayrılmış izin verilen CORS origin'leri (mobil için genellikle gerekli değil ama ileride web panel gelirse lazım)
CORS_ALLOWED_ORIGINS=

# Admin panel URL — /admin/ yerine tahmin edilmez bir URL kullan
DJANGO_ADMIN_URL=gizli-panel-url-buraya/

# Veritabanı
DB_NAME=hastalik_takip
DB_USER=postgres
DB_PASSWORD=GUCLU_BIR_PAROLA_YAZIN
DB_HOST=db
DB_PORT=5432

# Sentry (opsiyonel — boş bırakırsan devre dışı)
SENTRY_DSN=
# Sentry ortam etiketi (staging/production gibi ayrı Sentry projelerinde ayırt etmek için)
SENTRY_ENVIRONMENT=production
# Hata raporlarını sürümle eşleştirmek için — release yaparken güncelle
APP_VERSION=1.0.0

# Yedekleme (opsiyonel — sunucu kurulunca doldurulacak, scripts/backup_db.sh kullanır)
# rclone remote adı, örn: b2:hastalik-takip-backups (boş bırakılırsa sadece local yedek alınır)
RCLONE_REMOTE=
BACKUP_DIR=/backups
LOCAL_RETENTION_DAYS=7
